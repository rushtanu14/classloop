# Copy this file to .env.local. Do not commit .env.local.

# Free-first recommendation:
# - Use transcript paste/upload with no credentials by default.
# - For email, create/use a Gmail account you own, such as classloop.noreply@gmail.com.
# - Paid API-key or external LMS/Classroom posting features are intentionally not configured here.
# - Live capture uses free browser microphone/tab capture and speech recognition when available; transcript paste/upload remains the reliable free path.

# Generic SMTP
# CLASSLOOP_SMTP_HOST=smtp.example.com
# CLASSLOOP_SMTP_PORT=587
# CLASSLOOP_SMTP_SECURE=false
# CLASSLOOP_SMTP_USER=teacher@example.com
# CLASSLOOP_SMTP_PASS=replace-me
# CLASSLOOP_SMTP_FROM=teacher@example.com
# CLASSLOOP_SMTP_PROVIDER=SMTP

# Optional centralized sender. Use this for a no-reply-like mailbox you own.
# Replies can still route to a teacher or support inbox with CLASSLOOP_REPLY_TO.
# CLASSLOOP_NO_REPLY_EMAIL=classloop.noreply@gmail.com
# CLASSLOOP_NO_REPLY_NAME=ClassLoop
# CLASSLOOP_REPLY_TO=teacher@example.com

# Gmail SMTP alternative. Use a free Gmail account you own plus an app password, not your normal password.
# CLASSLOOP_GMAIL_USER=classloop.noreply@gmail.com
# CLASSLOOP_GMAIL_APP_PASSWORD=replace-me
# CLASSLOOP_GMAIL_FROM=classloop.noreply@gmail.com
# CLASSLOOP_FEEDBACK_NOTIFY_EMAIL=rushil@example.com

# Hosted web backend. Public browser keys are safe in Vite builds.
# Never put server/service-role secrets in VITE_* variables because Vite exposes them to browser JavaScript.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PRO_PRICE_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

# Desktop installer URLs are configured in public/classloop-downloads.json.
# Keep installer binaries outside Vercel Blob so Vercel only handles the web/PWA shell.
VITE_CLASSLOOP_PRODUCT_FEEDBACK_URL=
VITE_CLASSLOOP_SUPPORT_EMAIL=

# Server-only keys. Add these in Vercel project environment variables, not client code.
# Rotate these immediately if they are committed, pasted into a public tool, leaked in logs, or reused across test/live environments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CLASSLOOP_PUBLIC_URL=

# Optional hosted Whisper transcription. Server-only; never expose this as VITE_*.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
