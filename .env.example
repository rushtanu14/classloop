# Copy this file to .env.local. Do not commit .env.local.

# Free-first recommendation:
# - Use transcript paste/upload with no credentials by default.
# - For email, create/use a Gmail account you own, such as classloop.noreply@gmail.com.
# - Paid API-key or external LMS/Classroom posting features are intentionally not configured here.
# - Live capture uses free browser microphone/tab capture and speech recognition when available; transcript paste/upload remains the reliable free path.

# Generic SMTP
# CLASSLOOP_SMTP_HOST=smtp.example.com
# CLASSLOOP_SMTP_PORT=587
# CLASSLOOP_SMTP_SECURE=false
# CLASSLOOP_SMTP_USER=teacher@example.com
# CLASSLOOP_SMTP_PASS=replace-me
# CLASSLOOP_SMTP_FROM=teacher@example.com
# CLASSLOOP_SMTP_PROVIDER=SMTP

# Optional centralized sender. Use this for a no-reply-like mailbox you own.
# Replies can still route to a teacher or support inbox with CLASSLOOP_REPLY_TO.
# CLASSLOOP_NO_REPLY_EMAIL=classloop.noreply@gmail.com
# CLASSLOOP_NO_REPLY_NAME=ClassLoop
# CLASSLOOP_REPLY_TO=teacher@example.com

# Gmail SMTP alternative. This is ClassLoop's Gmail delivery path; Composio Gmail is not used.
# Keep the account and app password server-side here, never in a VITE_* variable or browser setting.
# Use a free Gmail account you own plus an app password, not your normal password.
# CLASSLOOP_GMAIL_USER=classloop.noreply@gmail.com
# CLASSLOOP_GMAIL_APP_PASSWORD=replace-me
# CLASSLOOP_GMAIL_FROM=classloop.noreply@gmail.com
# CLASSLOOP_FEEDBACK_NOTIFY_EMAIL=rushil@example.com

# Hosted web backend. Public browser keys are safe in Vite builds.
# Never put server/service-role secrets in VITE_* variables because Vite exposes them to browser JavaScript.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLASSLOOP_PUBLIC_URL=https://classloop-followup.vercel.app
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/7sY28qeT16Mh5wi0ZbeME00

# Desktop installer URLs are configured in public/classloop-downloads.json.
# Keep installer binaries outside Vercel Blob so Vercel only handles the web/PWA shell.
VITE_CLASSLOOP_PRODUCT_FEEDBACK_URL=
VITE_CLASSLOOP_SUPPORT_EMAIL=

# Server-only keys. Add these in Vercel project environment variables, not client code.
# Rotate these immediately if they are committed, pasted into a public tool, leaked in logs, or reused across test/live environments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
CLASSLOOP_PUBLIC_URL=

# Optional weekly Vercel Cron keepalive. The route signs in through Supabase Auth
# with this dedicated maintenance email/password so free Supabase projects stay active.
# Generate a long random CRON_SECRET and password; never expose either with VITE_*.
CRON_SECRET=
SUPABASE_KEEPALIVE_EMAIL=classloop.keepalive@example.com
SUPABASE_KEEPALIVE_PASSWORD=replace-me-with-a-long-random-password

# Optional local MCP and Composio connector scaffolding. Server-only; never expose these as VITE_*.
# The local MCP server is preview-first and redacts raw transcripts by default.
CLASSLOOP_MCP_STATE_PATH=
CLASSLOOP_MCP_REDACTION=strict
COMPOSIO_API_KEY=
# Dedicated AES-GCM key material for short-lived, teacher-bound provider record selections.
# Generate at least 32 random characters. Never reuse COMPOSIO_API_KEY and never expose this as VITE_*.
CLASSLOOP_INTEGRATION_SELECTION_SECRET=
# Administrator/bootstrap setup only. Hosted teachers receive a private server-derived id.
COMPOSIO_CLASSLOOP_USER_ID=classloop-teacher-local
COMPOSIO_CLASSLOOP_MCP_CONFIG_ID=
# Administrator/bootstrap setup only. Hosted teacher callbacks use CLASSLOOP_PUBLIC_URL above.
COMPOSIO_CLASSLOOP_CALLBACK_URL=
# Google Classroom and Google Forms require a custom Google OAuth app.
COMPOSIO_GOOGLE_CLASSROOM_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_FORMS_AUTH_CONFIG_ID=
# The following managed OAuth configs can be created with:
# npm run mcp:setup:composio -- --provision-managed --show-ids
# Run --show-ids only in a private terminal; save returned ids here or in server-only hosting variables.
COMPOSIO_ZOOM_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_MEET_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_DRIVE_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_DOCS_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_SHEETS_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_TASKS_AUTH_CONFIG_ID=
# Canvas and Blackboard require institution-specific credentials/admin setup.
COMPOSIO_CANVAS_AUTH_CONFIG_ID=
COMPOSIO_BLACKBOARD_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_MICROSOFT_TEAMS_AUTH_CONFIG_ID=
COMPOSIO_SLACK_AUTH_CONFIG_ID=
COMPOSIO_NOTION_AUTH_CONFIG_ID=

# Optional comma-separated exact Composio tool-name overrides, useful if a toolkit changes action names.
# Gmail email delivery intentionally stays outside Composio and uses CLASSLOOP_GMAIL_* or CLASSLOOP_SMTP_* above.
