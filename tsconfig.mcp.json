{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "dist-mcp",
    "rootDir": "."
  },
  "include": ["mcp/**/*.ts", "src/data.ts", "src/transcript.ts", "src/types.ts"]
}
